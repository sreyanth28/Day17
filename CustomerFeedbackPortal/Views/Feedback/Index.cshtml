@model CustomerFeedbackPortal.Models.Feedback
@using CustomerFeedbackPortal.Helpers

@{
    ViewData["Title"] = "Customer Feedback";
}

<h2>Customer Feedback Form</h2>

<form asp-controller="Feedback" asp-action="Submit" method="post">

    <div class="mb-3">
        <label>Name</label>
        @Html.StyledInput("Name", "Enter your name")
        @Html.ValidationMessageFor(m => m.Name)
    </div>

    <div class="mb-3">
        <label>Email</label>
        @Html.TextBoxFor(m => m.Email,
            new { @class = "form-control", placeholder = "Enter Email" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>

    <div class="mb-3">
        <label>Rating</label>

        @Html.DropDownListFor(m => m.Rating,
            new SelectList(new[]
            {
                "1","2","3","4","5"
            }),
            "Select Rating",
            new { @class = "form-control" })

        <br />

        <star-rating max-stars="5"
                     input-name="Rating">
        </star-rating>
    </div>

    <div class="mb-3">
        <label>Comments</label>
        @Html.TextAreaFor(m => m.Comments,
            new
            {
                @class = "form-control",
                rows = 5,
                placeholder = "Write comments"
            })
        @Html.ValidationMessageFor(m => m.Comments)
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Feedback
    </button>
</form>

<br />

<a asp-controller="Feedback"
       asp-action="Index"
       class="btn btn-secondary">
    Back to Form
</a>